{
    "manifest_version": 3,
    "name": "Nova-Perdanga",
    "version": "1.4",
    "description": "A minimal, open-source New Tab extension with built-in Wallhaven browsing and an offline local wallpaper library.",
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "icons": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://*.wallhaven.cc/*",
        "https://api.open-meteo.com/*",
        "https://get.geojs.io/*",
        "https://suggestqueries.google.com/*",
        "https://www.google.com/*",
        "https://duckduckgo.com/*",
        "https://api.qwant.com/*"
    ]
}