{
    "manifest_version": 3,
    "name": "Nova-Perdanga",
    "version": "1.4",
    "description": "Personal new tab dashboard: Wallhaven library, offline wallpapers, smart color adaptation, and power-user keyboard controls.",
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "icons": {
        "16": "assets/icons/NovaPerdanga.png",
        "32": "assets/icons/NovaPerdanga.png",
        "48": "assets/icons/NovaPerdanga.png",
        "128": "assets/icons/NovaPerdanga.png"
    },
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://*.wallhaven.cc/*",
        "https://api.open-meteo.com/*",
        "https://get.geojs.io/*",
        "https://suggestqueries.google.com/*",
        "https://duckduckgo.com/*",
        "https://api.bing.com/*"
    ]
}